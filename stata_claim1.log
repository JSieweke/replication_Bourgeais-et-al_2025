. *---- 4. Window-level chi-square computed from possession totals ----------------
. * (used by the permutation test; data = one row per possession with
. *  k = involved windows, n = windows, neg = outcome)
. capture program drop winchi2

. program define winchi2, rclass
  1.     quietly summarize k if neg == 1, meanonly
  2.     local a = r(sum)
  3.     quietly summarize n if neg == 1, meanonly
  4.     local b = r(sum) - `a'
  5.     quietly summarize k if neg == 0, meanonly
  6.     local c = r(sum)
  7.     quietly summarize n if neg == 0, meanonly
  8.     local d = r(sum) - `c'
  9.     return scalar chi2 = (`a' + `b' + `c' + `d') * (`a'*`d' - `b'*`c')^2 / ///
>         ((`a' + `b') * (`c' + `d') * (`a' + `c') * (`b' + `d'))
 10. end

. 
. * boottest (wild cluster bootstrap) for the game- and team-level checks
. capture which boottest

. if _rc ssc install boottest

. 
. *---- 5. Tests for the 8 position-by-metric cells -------------------------------
. matrix R = J(8, 8, .)

. local row = 0

. local names ""

. foreach m in fc fb {
  2.     foreach q in PG SF PF C {
  3.         local ++row
  4.         local y `m'_`q'
  5.         local names `names' `q'_`=strupper("`m'")'
  6. 
.         quietly summarize `y' if neg == 1, meanonly
  7.         matrix R[`row', 1] = 100 * r(mean)
  8.         quietly summarize `y' if neg == 0, meanonly
  9.         matrix R[`row', 2] = 100 * r(mean)
 10. 
.         * (a) windows treated as independent, as in the article
.         quietly tabulate `y' neg, chi2
 11.         matrix R[`row', 3] = r(p)
 12. 
.         * (b) logit, standard errors clustered by possession
.         quietly logit `y' neg, vce(cluster pid)
 13.         matrix R[`row', 4] = 2 * normal(-abs(_b[neg] / _se[neg]))
 14. 
.         * (c) one observation per possession: share of involved windows, rank-sum test
.         preserve
 15.         quietly collapse (mean) share = `y' (max) neg, by(pid)
 16.         quietly ranksum share, by(neg)
 17.         matrix R[`row', 5] = 2 * normal(-abs(r(z)))
 18.         restore
 19. 
.         * (d) permutation of outcomes across whole possessions, 5,000 draws
.         preserve
 20.         quietly collapse (sum) k = `y' (count) n = `y' (max) neg, by(pid)
 21.         quietly permute neg chi2 = r(chi2), reps(5000) rseed(20250520) nodots: winchi2
 22.         matrix P = r(p_upper)
 23.         matrix R[`row', 6] = P[1, 1]
 24.         restore
 25. 
.         * (e) nesting beyond possessions: linear probability model with
.         *     wild cluster bootstrap (Webb weights), clusters = games (12) and teams (8).
.         *     Few clusters: treat as indicative only.
.         quietly regress `y' neg, vce(cluster gid)
 26.         quietly boottest neg, reps(9999) weighttype(webb) seed(20250520) nograph
 27.         matrix R[`row', 7] = r(p)
 28.         quietly regress `y' neg, vce(cluster tid)
 29.         quietly boottest neg, reps(9999) weighttype(webb) seed(20250520) nograph
 30.         matrix R[`row', 8] = r(p)
 31.     }
 32. }

